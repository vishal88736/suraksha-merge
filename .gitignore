!/.yarn/versions/

# Generated builds and framework state
/dist/
/.next/
/.vinext/
/out/
next-env.d.ts
*.tsbuildinfo

# Test output
/coverage/

# Package-manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local environment and keys
.env*
.dev.vars*
*.pem

# Checkout-local tool state
/.wrangler/
/.sites-runtime/

# Workspace scaffolding and publication archives
/.agents/
/.codex/
/outputs/
/work/

# OS metadata
.DS_Store

# Research and private runtime data
.venv/
__pycache__/
*.pyc
checkpoints/
data/generated*/
data/private/
artifacts/
.env
!.env.example

# Original public downloads and derived corpora remain local
/data/raw/
/data/processed/
/data/benchmarks_external/
.venv-training/
.~lock.*#
/data/review/
.i18n-pylib/
